# Local values only; production and DEV secrets are injected by GoodMorning Factory.
APP_NAME=ArcoEnergy API
APP_ENV=local
SOURCE_COMMIT=unknown
ORGANIZATION_ID=arcoenergy
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081
DATABASE_URL=postgresql+psycopg://goodmorning:goodmorning_local_password@postgres:5432/goodmorning_mvp

# Vite build variables. The DEV gateway serves each application on its own route.
VITE_API_URL=/api
VITE_BASE_PATH=/app/

# Optional external integrations. Leave empty until credentials and access are configured.
GOOGLE_DRIVE_FOLDER_ID=
WHATSAPP_PHONE=

# Local Docker Compose only; never copy these values into Coolify.
POSTGRES_DB=goodmorning_mvp
POSTGRES_USER=goodmorning
POSTGRES_PASSWORD=goodmorning_local_password
GATEWAY_PORT=18081
