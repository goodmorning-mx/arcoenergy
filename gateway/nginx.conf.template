server {
  listen 80;
  server_name _;

  resolver 127.0.0.11 ipv6=off valid=5s;
  resolver_timeout 2s;

  proxy_http_version 1.1;
  proxy_set_header Host ${DOLLAR}host;
  proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
  proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
  proxy_set_header Upgrade ${DOLLAR}http_upgrade;
  proxy_set_header Connection "upgrade";

  location = /health {
    default_type application/json;
    return 200 '{"service":"frontend-gateway","status":"ok"}';
  }

  location = /app {
    return 301 /app/;
  }

  location = /crm {
    return 301 /crm/;
  }

  location = /login {
    rewrite ^ /crm/login last;
  }

  location = /login/ {
    rewrite ^ /crm/login last;
  }

  location /crm/ {
    rewrite ^/crm/(.*)$ /$1 break;
    proxy_pass ${CRM_UPSTREAM}${DOLLAR}uri${DOLLAR}is_args${DOLLAR}args;
  }

  location /app/ {
    rewrite ^/app/(.*)$ /$1 break;
    proxy_pass ${REACT_UPSTREAM}${DOLLAR}uri${DOLLAR}is_args${DOLLAR}args;
  }

  location = /api {
    rewrite ^/api$ / break;
    proxy_pass ${API_UPSTREAM}${DOLLAR}uri${DOLLAR}is_args${DOLLAR}args;
  }

  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass ${API_UPSTREAM}${DOLLAR}uri${DOLLAR}is_args${DOLLAR}args;
  }

  location = /seo {
    rewrite ^/seo$ / break;
    proxy_pass ${NEXT_UPSTREAM}${DOLLAR}uri${DOLLAR}is_args${DOLLAR}args;
  }

  location /seo/ {
    rewrite ^/seo(/.*)$ $1 break;
    proxy_pass ${NEXT_UPSTREAM}${DOLLAR}uri${DOLLAR}is_args${DOLLAR}args;
  }

  location /_next/ {
    proxy_pass ${NEXT_UPSTREAM}${DOLLAR}uri${DOLLAR}is_args${DOLLAR}args;
  }

  location / {
    proxy_pass ${NEXT_UPSTREAM}${DOLLAR}uri${DOLLAR}is_args${DOLLAR}args;
  }

  error_page 502 = /gateway-502;
  error_page 504 = /gateway-504;

  location = /gateway-502 {
    default_type application/json;
    return 502 '{"status":"bad_gateway","message":"Upstream service unavailable"}';
  }

  location = /gateway-504 {
    default_type application/json;
    return 504 '{"status":"gateway_timeout","message":"Upstream service timed out"}';
  }
}
