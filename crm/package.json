{
  "name": "arcoenergy-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm --prefix node_modules/@goodmorning/gm-auth run build && npm --prefix node_modules/@goodmorning/gm-agent/frontend run build"
  },
  "dependencies": {
    "@goodmorning/gm-agent": "https://github.com/goodmorning-mx/gm-agent/archive/1a083cc146984da3eb15ba722303a351227184df.tar.gz",
    "@goodmorning/gm-auth": "https://github.com/goodmorning-mx/gm-auth/archive/138d66cb44a94781e0d38d8afd1be2dbf718c294.tar.gz",
    "@vitejs/plugin-react": "5.0.0",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  }
}
